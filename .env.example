# Optional. Needed only for --llm (RAG generation) and the naive LLM mode.
GEMINI_API_KEY=your_api_key_here

# Optional. Point VaultBot at your own vault. This file is gitignored, so the
# path to your notes never enters the repository. Defaults to sample_vault.
# VAULT_PATH=/absolute/path/to/your/vault

# Optional. Comma separated glob patterns (vault relative) to never index.
# VAULT_EXCLUDE=journal/*,finances/*
